# Server Configuration
PORT=4981
# Optional local listener address; use 127.0.0.1 for browser relay backend.
GEHIHI_BIND_HOST=
# Local account vault (AES-GCM, key derived from workspace API_KEY). Never deploy this file.
GEHIHI_ACCOUNT_STORE=.accounts/vault.enc
API_KEY=
# Optional cross-origin clients, comma separated. Same-origin UI needs none.
ALLOWED_ORIGINS=
# Optional externally managed OpenAI-compatible gateway (include /v1).
# Leave empty to use Gemini Web. This does not create an Antigravity API.
UPSTREAM_BASE_URL=
# Optional Gemini-compatible backend base (include /gemini/v1beta or /v1beta).
# Requires UPSTREAM_BASE_URL too. Streaming replies are buffered as one SSE event.
UPSTREAM_GEMINI_BASE_URL=
UPSTREAM_API_KEY=
LOG_LEVEL=info
APP_ENV=development
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Gemini Configuration
# Optional local Chrome session relay; replaces exported Cookie transport.
# Local backend only, never set this loopback URL on Vercel. See docs/BROWSER_RELAY.md.
GEMINI_BROWSER_RELAY_URL=
# Open Developer Tools (F12) -> Network, select a Gemini batchexecute request,
# and copy its complete Cookie request header.
GEMINI_COOKIES=
# If that request URL contains /u/2/, set 2 here. Leave empty when the URL has
# no /u/<number>/ segment. The cookie and slot must come from the same tab.
GEMINI_AUTH_USER=
GEMINI_REFRESH_INTERVAL=1440
GEMINI_MAX_RETRIES=3
GEMINI_TEMPORARY=true
