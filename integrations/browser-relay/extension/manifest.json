{
  "manifest_version": 3,
  "name": "Gehihi Gemini Session Bridge",
  "version": "1.1.0",
  "description": "Send Gehihi chat requests through your selected, signed-in Gemini tab. Does not read or export cookies.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["https://gemini.google.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_title": "Gehihi Gemini Bridge", "default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]
}
